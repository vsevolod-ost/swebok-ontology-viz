#################################################################
# 7. Декомпозиція KA 6 «Software Engineering Operations» (розділ 4)
#################################################################

swe:KA6 swe:notation "P6" ;
    rdfs:comment "the set of activities and tasks necessary to deploy, operate and support a software application or system while preserving its integrity and stability"@en ;
    swe:hasInput "release candidate від KA 4; нефункціональні вимоги; запити на зміни та звіти про проблеми; бізнес-прогнози; угоди з постачальниками"@uk ;
    swe:hasOutput "розгорнутий продукт; операційний сервіс за SLA; сервісні звіти; записи інцидентів/проблем/змін; телеметрія та KPI; плани"@uk ;
    swe:hasMechanism "інженери операцій та інженери ПЗ; контейнери й віртуалізація; засоби розгортання; автоматизоване тестування; моніторинг і телеметрія"@uk ;
    swe:hasEnvironment "середовища розроблення, QA, передпродуктивне, продуктивне; ІТ-інфраструктура; IaaS/PaaS; постачальники"@uk ;
    swe:hasTechnology "DevOps, IaC, PaC, CI/CD, SRE, Platform Engineering, ITIL/ISO/IEC 20000-1"@uk ;
    swe:hasGoal "цілісність і стабільність системи; досягнення цільових рівнів обслуговування; мінімізація порушень від інцидентів"@uk ;
    swe:hasMetric "доступність; навантаження; продуктивність; обсяг транзакцій; використання ресурсів; кількість інцидентів"@uk ;
    swe:hasIndicator "KPI у реальному часі за §4.2: телеметрія, результати V&V, активність користувачів, залежності, зміни конфігурації, безпека і стійкість"@uk .

