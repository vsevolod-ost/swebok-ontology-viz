@prefix swe:  <http://kai.edu.ua/ontology/ipz-swebok-v4#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .

#################################################################
# Онтологія ПрО «Інженерія програмного забезпечення» на основі
# SWEBOK Guide v4.0 (IEEE CS, 2024). Лабораторна робота № 2 з ОІПЗ.
# Згенеровано скриптом ontology/generate_ttl.py з ontology/data.py.
#################################################################

<http://kai.edu.ua/ontology/ipz-swebok-v4> a owl:Ontology ;
    rdfs:label "Системна онтологія ІПЗ на основі SWEBOK Guide v4.0"@uk ;
    rdfs:comment "Онтологія O = (X, R, F, A): X — класи та індивіди; R — об'єктні властивості (УЗ ЛПМ); F — анотації rdfs:label/rdfs:comment/rdfs:seeAlso; A — аксіоми. В OWL виражено: A1 (диз'юнктність складових Ос, функціональність belongsTo, еквівалентність класів KA обмеженням belongsTo), A2 (транзитивність а, х). A3 (ациклічність) і A6 (деревоподібність) перевіряє ontology/check.py: OWL 2 DL забороняє асиметричність і обмеження кардинальності на транзитивних властивостях."@uk ;
    dct:source "Guide to the Software Engineering Body of Knowledge, Version 4.0 / ed. H. Washizaki. IEEE Computer Society, 2024."@en ;
    owl:versionInfo "1.1 (2026-09-24)" .

#################################################################
# 1. Класи верхнього рівня — системна онтологія Ос = (Oо, Oп, Oз)
#################################################################

swe:Concept a owl:Class ;
    rdfs:label "Концепт ПрО ІПЗ"@uk ;
    rdfs:comment "Елемент множини X онтології O = (X, R, F, A) (лекція 2, сл. 14)."@uk .

swe:PrimaryConcept a owl:Class ; rdfs:subClassOf swe:Concept ;
    rdfs:label "Первинне (аксіоматичне) поняття"@uk ;
    rdfs:comment "Поняття суміжних ПрО — аксіоматичний шар ЛПМ (лекція 2, сл. 21–22)."@uk .
swe:BasicConcept a owl:Class ; rdfs:subClassOf swe:Concept ;
    rdfs:label "Базове поняття ПрО ІПЗ"@uk ;
    rdfs:comment "Утворене з первинних через УЗ — базовий шар ЛПМ."@uk .
swe:DerivedConcept a owl:Class ; rdfs:subClassOf swe:Concept ;
    rdfs:label "Похідне поняття"@uk ;
    rdfs:comment "Утворене з базових/первинних через УЗ — шар похідних понять ЛПМ."@uk .

swe:KnowledgeArea a owl:Class ; rdfs:subClassOf swe:DerivedConcept ;
    rdfs:label "Область знань SWEBOK (Knowledge Area)"@uk ;
    rdfs:comment "Ідентифікована область інженерії ПЗ, що визначається вимогами до знань і описується у термінах складових процесів, практик, входів, виходів, інструментів і технік (SWEBOK v4.0, с. xxv)."@uk .

swe:SystemOntologyComponent a owl:Class ;
    rdfs:label "Складова системної онтології"@uk .
swe:ProcessOntology a owl:Class ; rdfs:subClassOf swe:SystemOntologyComponent ;
    rdfs:label "Онтологія процесів Oп"@uk ;
    rdfs:comment "Ієрархічна структура процесів, підпроцесів, дій і операцій (лекція 2, сл. 15)."@uk .
swe:ObjectOntology a owl:Class ; rdfs:subClassOf swe:SystemOntologyComponent ;
    rdfs:label "Онтологія об'єктів Oо"@uk ;
    rdfs:comment "Ієрархічна структура класів, підкласів та елементів класів понять, на які посилаються Oп і Oз."@uk .
swe:TaskOntology a owl:Class ; rdfs:subClassOf swe:SystemOntologyComponent ;
    rdfs:label "Онтологія задач Oз"@uk ;
    rdfs:comment "Ієрархічна структура задач, підзадач, процедур і операторів."@uk .
[] a owl:AllDisjointClasses ; owl:members ( swe:ProcessOntology swe:ObjectOntology swe:TaskOntology ) .

# Класи-члени складових Ос (аксіома A1: KA належить рівно одній складовій)
swe:ProcessKA a owl:Class ; rdfs:subClassOf swe:KnowledgeArea ;
    rdfs:label "Процесна область знань (член Oп)"@uk ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( swe:KnowledgeArea
        [ a owl:Restriction ; owl:onProperty swe:belongsTo ; owl:hasValue swe:ProcessOntologyOfIPZ ] ) ] .
swe:ObjectKA a owl:Class ; rdfs:subClassOf swe:KnowledgeArea ;
    rdfs:label "Об'єктна область знань (член Oо)"@uk ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( swe:KnowledgeArea
        [ a owl:Restriction ; owl:onProperty swe:belongsTo ; owl:hasValue swe:ObjectOntologyOfIPZ ] ) ] .
swe:TaskKA a owl:Class ; rdfs:subClassOf swe:KnowledgeArea ;
    rdfs:label "Задачна область знань (член Oз)"@uk ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( swe:KnowledgeArea
        [ a owl:Restriction ; owl:onProperty swe:belongsTo ; owl:hasValue swe:TaskOntologyOfIPZ ] ) ] .
[] a owl:AllDisjointClasses ; owl:members ( swe:ProcessKA swe:ObjectKA swe:TaskKA ) .

# Ієрархія онтології процесів (лекція 2, сл. 15) та класи процесів (лекція 3, сл. 6)
swe:Process a owl:Class ; rdfs:subClassOf swe:Concept ;
    rdfs:label "Процес"@uk ;
    rdfs:comment "Фіксовані в часі зміни станів виокремленої сукупності сутностей (лекція 3, сл. 6, 8)."@uk .
swe:ActivityProcess a owl:Class ; rdfs:subClassOf swe:Process ; rdfs:label "Процес діяльності"@uk .
swe:PurposefulProcess a owl:Class ; rdfs:subClassOf swe:ActivityProcess ; rdfs:label "Доцільний процес діяльності"@uk .
swe:ProductionProcess a owl:Class ; rdfs:subClassOf swe:PurposefulProcess ; rdfs:label "Продуктовий виробничий процес"@uk .
swe:ProjectProcess a owl:Class ; rdfs:subClassOf swe:ProductionProcess ; rdfs:label "Процес-проєкт"@uk .
swe:SoftwareEngineeringProcess a owl:Class ; rdfs:subClassOf swe:ProductionProcess ;
    rdfs:label "Процес програмної інженерії (процес ПІ)"@uk ;
    rdfs:comment "Продуктовий процес, об'єктом діяльності якого є програмні продукти (лекція 3, сл. 6, 10). Операційні процеси мають сервісний, а не проєктний характер (SWEBOK v4.0, с. 6-6), тому клас підпорядковано ProductionProcess."@uk .
swe:SubProcess a owl:Class ; rdfs:subClassOf swe:Process ; rdfs:label "Підпроцес"@uk .
swe:Action a owl:Class ; rdfs:subClassOf swe:Process ; rdfs:label "Дія"@uk .
swe:Operation a owl:Class ; rdfs:subClassOf swe:Process ; rdfs:label "Операція"@uk .
swe:FundamentalAction a owl:Class ; rdfs:subClassOf swe:Action ;
    rdfs:label "Наскрізна базова дія"@uk ;
    rdfs:comment "Дія з розділу Fundamentals, яка використовується у кількох підпроцесах (аксіома A6)."@uk .
swe:PracticalConsideration a owl:Class ; rdfs:subClassOf swe:Concept ;
    rdfs:label "Практичне міркування (модифікатор процесу)"@uk .
swe:Tool a owl:Class ; rdfs:subClassOf swe:Concept ;
    rdfs:label "Інструментальний засіб (механізм процесу, член Oо)"@uk .
swe:SystemicUnion a owl:Class ; rdfs:subClassOf swe:DerivedConcept ;
    rdfs:label "Системологічне поєднання"@uk ;
    rdfs:comment "Нове поняття С, яке не є простою сумою складових понять (лекція 2, сл. 27, УЗ типу s)."@uk .

# Концепти онтології процесу (лекція 3, сл. 8–9) — властивості даних паспорта процесу
swe:hasInput a owl:AnnotationProperty ; rdfs:label "входи процесу"@uk .
swe:hasOutput a owl:AnnotationProperty ; rdfs:label "виходи процесу"@uk .
swe:hasMechanism a owl:AnnotationProperty ; rdfs:label "механізми процесу"@uk .
swe:hasEnvironment a owl:AnnotationProperty ; rdfs:label "середовище процесу"@uk .
swe:hasTechnology a owl:AnnotationProperty ; rdfs:label "технологія процесу"@uk .
swe:hasGoal a owl:AnnotationProperty ; rdfs:label "цілі процесу"@uk .
swe:hasMetric a owl:AnnotationProperty ; rdfs:label "метрики процесу"@uk .
swe:hasIndicator a owl:AnnotationProperty ; rdfs:label "показники процесу"@uk .
swe:notation a owl:AnnotationProperty ; rdfs:label "позначення в тексті роботи"@uk .

#################################################################
# 2. Об'єктні властивості — уніфіковані зв'язки ЛПМ (лекція 2, сл. 27)
#################################################################

swe:unifiedLink a owl:ObjectProperty ;
    rdfs:label "уніфікований зв'язок (УЗ)"@uk ;
    rdfs:domain swe:Concept ; rdfs:range swe:Concept .

swe:isPropertyOf a owl:ObjectProperty ; rdfs:subPropertyOf swe:unifiedLink ;
    rdfs:label "ознака, властивість (о): A є ознакою B"@uk .
swe:isPartOf a owl:ObjectProperty , owl:TransitiveProperty ; rdfs:subPropertyOf swe:unifiedLink ;
    rdfs:label "складова (а): A є складовою B"@uk ;
    rdfs:comment "Транзитивна (лекція 2, сл. 21); ациклічна за аксіомою A3."@uk .
swe:isKindOf a owl:ObjectProperty , owl:TransitiveProperty ; rdfs:subPropertyOf swe:unifiedLink ;
    rdfs:label "різновид (х): A є різновидом B"@uk .
swe:hasInstance a owl:ObjectProperty ; rdfs:subPropertyOf swe:unifiedLink ;
    rdfs:label "клас (к): B є екземпляром класу A"@uk .
swe:systemicUnionOf a owl:ObjectProperty ; rdfs:subPropertyOf swe:unifiedLink ;
    rdfs:label "системологічне поєднання (s): C утворене поєднанням A, B, …"@uk .
swe:usedIn a owl:ObjectProperty ;
    rdfs:label "використовується у (наскрізна дія → дія/підпроцес)"@uk .
swe:appliesTo a owl:ObjectProperty ;
    rdfs:label "застосовується до (практичне міркування → процес)"@uk .
swe:belongsTo a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "належить до складової Ос (аксіома A1)"@uk ;
    rdfs:domain swe:Concept ; rdfs:range swe:SystemOntologyComponent .
swe:processRoleLink a owl:ObjectProperty ;
    rdfs:label "роль KA у паспорті процесу (IDEF0: вхід, механізм, середовище) — не УЗ ЛПМ"@uk ;
    rdfs:domain swe:Process ; rdfs:range swe:KnowledgeArea .
swe:hasInputFrom a owl:ObjectProperty ; rdfs:subPropertyOf swe:processRoleLink ; rdfs:label "отримує вхід від"@uk .
swe:hasMechanismFrom a owl:ObjectProperty ; rdfs:subPropertyOf swe:processRoleLink ; rdfs:label "використовує механізм з"@uk .
swe:hasEnvironmentFrom a owl:ObjectProperty ; rdfs:subPropertyOf swe:processRoleLink ; rdfs:label "виконується в середовищі, заданому"@uk .
swe:swebokSection a owl:DatatypeProperty ; rdfs:label "розділ SWEBOK v4.0"@uk ; rdfs:range xsd:string .
swe:swebokPage a owl:DatatypeProperty ; rdfs:label "сторінка SWEBOK v4.0"@uk ; rdfs:range xsd:string .
swe:kaNumber a owl:DatatypeProperty ; rdfs:label "номер області знань"@uk ; rdfs:range xsd:integer .

#################################################################
# 3. Складові системної онтології (індивіди)
#################################################################

swe:ProcessOntologyOfIPZ a swe:ProcessOntology , owl:NamedIndividual ;
    rdfs:label "Онтологія процесів Oп"@uk .

swe:ObjectOntologyOfIPZ a swe:ObjectOntology , owl:NamedIndividual ;
    rdfs:label "Онтологія об'єктів Oо"@uk .

swe:TaskOntologyOfIPZ a swe:TaskOntology , owl:NamedIndividual ;
    rdfs:label "Онтологія задач Oз"@uk .


#################################################################
# 4. Первинні та базові поняття (індивіди шарів ЛПМ)
#################################################################

swe:P_S a swe:PrimaryConcept , owl:NamedIndividual ;
    rdfs:label "Система"@uk ;
    rdfs:comment "Множина взаємозв'язаних елементів, виокремлена із середовища, яка взаємодіє з ним як єдине ціле"@uk ;
    rdfs:seeAlso "Теорія систем; Л2 сл. 25; KA 16 §1 (с. 16-2)"@uk .

swe:P_e a swe:PrimaryConcept , owl:NamedIndividual ;
    rdfs:label "Елемент"@uk ;
    rdfs:comment "Самостійна частина деякого цілого, системи"@uk ;
    rdfs:seeAlso "Теорія систем; Л2 сл. 25"@uk .

swe:P_P a swe:PrimaryConcept , owl:NamedIndividual ;
    rdfs:label "Взаємодія"@uk ;
    rdfs:comment "Процес впливу об'єктів один на одного, що супроводжується переміщенням енергії, речовини, інформації"@uk ;
    rdfs:seeAlso "Теорія систем; Л2 сл. 25"@uk .

swe:P_c a swe:PrimaryConcept , owl:NamedIndividual ;
    rdfs:label "Середовище"@uk ;
    rdfs:comment "Сукупність об'єктів, зміна властивостей яких впливає на систему, і тих, чиї властивості змінюються під впливом системи"@uk ;
    rdfs:seeAlso "Теорія систем; Л2 сл. 25"@uk .

swe:P_D a swe:PrimaryConcept , owl:NamedIndividual ;
    rdfs:label "Стан системи"@uk ;
    rdfs:comment "Сукупність властивостей і параметрів системи у фіксований момент часу"@uk ;
    rdfs:seeAlso "Теорія систем; Л2 сл. 25"@uk .

swe:P_Pr a swe:PrimaryConcept , owl:NamedIndividual ;
    rdfs:label "Процес"@uk ;
    rdfs:comment "Зафіксовані у часовому вимірі зміни станів системи, обумовлені внутрішніми та зовнішніми взаємодіями"@uk ;
    rdfs:seeAlso "Л3 сл. 8; KA 18 §1 (с. 18-1)"@uk .

swe:P_G a swe:PrimaryConcept , owl:NamedIndividual ;
    rdfs:label "Ціль"@uk ;
    rdfs:comment "Бажаний стан або область станів системи"@uk ;
    rdfs:seeAlso "Теорія управління; Л2 сл. 26; Л3 сл. 9"@uk .

swe:P_U a swe:PrimaryConcept , owl:NamedIndividual ;
    rdfs:label "Управління"@uk ;
    rdfs:comment "Процес впливу суб'єкта управління на об'єкт управління для досягнення визначеної мети"@uk ;
    rdfs:seeAlso "Теорія управління; Л2 сл. 26"@uk .

swe:P_I a swe:PrimaryConcept , owl:NamedIndividual ;
    rdfs:label "Інформація"@uk ;
    rdfs:comment "Відомості, що зменшують невизначеність стану об'єкта"@uk ;
    rdfs:seeAlso "Теорія інформації; Л2 сл. 22"@uk .

swe:P_d a swe:PrimaryConcept , owl:NamedIndividual ;
    rdfs:label "Дані"@uk ;
    rdfs:comment "Формалізоване подання інформації, придатне для обробки"@uk ;
    rdfs:seeAlso "KA 16 §3, §6 (с. 16-6, 16-17)"@uk .

swe:P_C a swe:PrimaryConcept , owl:NamedIndividual ;
    rdfs:label "Обчислення"@uk ;
    rdfs:comment "Перетворення даних за алгоритмом на обчислювальній машині"@uk ;
    rdfs:seeAlso "KA 16 §2–§4 (с. 16-3…16-10)"@uk .

swe:P_A a swe:PrimaryConcept , owl:NamedIndividual ;
    rdfs:label "Алгоритм"@uk ;
    rdfs:comment "Скінченна послідовність інструкцій перетворення даних"@uk ;
    rdfs:seeAlso "KA 16 §3 (с. 16-6)"@uk .

swe:P_M a swe:PrimaryConcept , owl:NamedIndividual ;
    rdfs:label "Модель"@uk ;
    rdfs:comment "Абстрактне подання системи, що зберігає її суттєві властивості"@uk ;
    rdfs:seeAlso "KA 18 §6 (с. 18-8); KA 11 §1 (с. 11-1)"@uk .

swe:P_m a swe:PrimaryConcept , owl:NamedIndividual ;
    rdfs:label "Вимірювання"@uk ;
    rdfs:comment "Приписування чисел властивостям об'єктів за правилами"@uk ;
    rdfs:seeAlso "KA 18 §7 (с. 18-10)"@uk .

swe:P_SetRelationFunction a swe:PrimaryConcept , owl:NamedIndividual ;
    rdfs:label "Множина, відношення, функція"@uk ;
    rdfs:comment "Базові математичні структури"@uk ;
    rdfs:seeAlso "KA 17 §3 (с. 17-5)"@uk .

swe:P_r a swe:PrimaryConcept , owl:NamedIndividual ;
    rdfs:label "Ризик"@uk ;
    rdfs:comment "Поєднання ймовірності події та її наслідків"@uk ;
    rdfs:seeAlso "KA 9 §2.5; KA 15 §9; Л2 сл. 30"@uk .

swe:P_Cost a swe:PrimaryConcept , owl:NamedIndividual ;
    rdfs:label "Вартість"@uk ;
    rdfs:comment "Грошова міра ресурсів, витрачених на отримання результату"@uk ;
    rdfs:seeAlso "KA 15 §1 (с. 15-3)"@uk .

swe:P_H a swe:PrimaryConcept , owl:NamedIndividual ;
    rdfs:label "Людина (суб'єкт діяльності)"@uk ;
    rdfs:comment "Носій цілей, знань і активної діяльності у процесах"@uk ;
    rdfs:seeAlso "Л3 сл. 6, 8; KA 16 §8 (с. 16-24)"@uk .

swe:B_SW a swe:BasicConcept , owl:NamedIndividual ;
    rdfs:label "Програмне забезпечення (ПЗ)"@uk ;
    rdfs:comment "Упорядкована множина машинних кодів разом із артефактами, що забезпечують їх розроблення, впровадження і використання"@uk ;
    swe:lpmFormula "(х) S; (а) d, A"@uk ;
    rdfs:seeAlso "Л1 сл. 14, 17, 19; SEVOCAB"@uk .

swe:B_SP a swe:BasicConcept , owl:NamedIndividual ;
    rdfs:label "Програмний продукт"@uk ;
    rdfs:comment "Завершене програмне рішення, готове до використання; цільовий результат процесів ІПЗ"@uk ;
    swe:lpmFormula "(х) SW"@uk ;
    rdfs:seeAlso "Л1 сл. 16"@uk .

swe:B_SH a swe:BasicConcept , owl:NamedIndividual ;
    rdfs:label "Стейкхолдер"@uk ;
    rdfs:comment "Людина або організація, що має інтерес до результату процесу"@uk ;
    swe:lpmFormula "(х) H; (о) G"@uk ;
    rdfs:seeAlso "KA 1 §2.1; KA 2 §1.2 (с. 2-3)"@uk .

swe:B_Rq a swe:BasicConcept , owl:NamedIndividual ;
    rdfs:label "Вимога"@uk ;
    rdfs:comment "Властивість, яку має виявляти ПЗ для розв'язання задачі стейкхолдера"@uk ;
    swe:lpmFormula "(о) SH; —о→ SP"@uk ;
    rdfs:seeAlso "KA 1 §1.1 (с. 1-2)"@uk .

swe:B_PI a swe:BasicConcept , owl:NamedIndividual ;
    rdfs:label "Процес інженерії ПЗ (процес ПІ)"@uk ;
    rdfs:comment "Доцільний продуктовий процес діяльності, об'єктом якого є програмний продукт"@uk ;
    swe:lpmFormula "(х) Pr; (о) H, G, SP"@uk ;
    rdfs:seeAlso "Л3 сл. 6, 10; KA 10 §1.2 (с. 10-3)"@uk .

swe:B_Pj a swe:BasicConcept , owl:NamedIndividual ;
    rdfs:label "Проєкт"@uk ;
    rdfs:comment "Сукупність дій з визначеними термінами для створення продукту відповідно до ресурсів і вимог"@uk ;
    swe:lpmFormula "(х) PI"@uk ;
    rdfs:seeAlso "Л3 сл. 11; ISO/IEC/IEEE 12207"@uk .

swe:B_LC a swe:BasicConcept , owl:NamedIndividual ;
    rdfs:label "Життєвий цикл ПЗ"@uk ;
    rdfs:comment "Упорядкована сукупність процесів від задуму до виведення з експлуатації"@uk ;
    swe:lpmFormula "(а) PI; (о) D"@uk ;
    rdfs:seeAlso "KA 10 §2.1 (с. 10-3)"@uk .

swe:B_Af a swe:BasicConcept , owl:NamedIndividual ;
    rdfs:label "Артефакт"@uk ;
    rdfs:comment "Матеріальний або інформаційний результат процесу ПІ (специфікація, модель, код, збірка)"@uk ;
    swe:lpmFormula "(х) d, M"@uk ;
    rdfs:seeAlso "Л3 сл. 11 (вихід процесу)"@uk .

swe:B_Cfg a swe:BasicConcept , owl:NamedIndividual ;
    rdfs:label "Конфігурація ПЗ"@uk ;
    rdfs:comment "Сукупність ідентифікованих елементів ПЗ у фіксованому стані"@uk ;
    swe:lpmFormula "(а) SW, Af, e; (о) D"@uk ;
    rdfs:seeAlso "KA 8 §2 (с. 8-6)"@uk .

swe:B_Q a swe:BasicConcept , owl:NamedIndividual ;
    rdfs:label "Якість ПЗ"@uk ;
    rdfs:comment "Ступінь відповідності ПЗ потребам стейкхолдерів; сукупність характеристик"@uk ;
    swe:lpmFormula "(о) Rq; —о→ SP"@uk ;
    rdfs:seeAlso "KA 12 §1 (с. 12-3)"@uk .

swe:B_Sec a swe:BasicConcept , owl:NamedIndividual ;
    rdfs:label "Безпека ПЗ"@uk ;
    rdfs:comment "Здатність ПЗ захищати інформацію та дані від несанкціонованих дій"@uk ;
    swe:lpmFormula "(х) Q"@uk ;
    rdfs:seeAlso "KA 13 §1 (с. 13-1)"@uk .

swe:B_Eng a swe:BasicConcept , owl:NamedIndividual ;
    rdfs:label "Інженер ПЗ (фахівець)"@uk ;
    rdfs:comment "Суб'єкт професійної діяльності, який реалізує процеси ПІ"@uk ;
    swe:lpmFormula "(х) H; (о) PI"@uk ;
    rdfs:seeAlso "Л2 сл. 33; KA 14 §1"@uk .

swe:B_T a swe:BasicConcept , owl:NamedIndividual ;
    rdfs:label "Інструментальний засіб"@uk ;
    rdfs:comment "Програмний засіб, який автоматизує дії процесів ПІ"@uk ;
    swe:lpmFormula "(х) SW; —а→ PI"@uk ;
    rdfs:seeAlso "Л2 сл. 32"@uk .

swe:B_Mt a swe:BasicConcept , owl:NamedIndividual ;
    rdfs:label "Метод ІПЗ"@uk ;
    rdfs:comment "Упорядкований спосіб виконання дій процесу ПІ"@uk ;
    swe:lpmFormula "(х) M; —а→ PI"@uk ;
    rdfs:seeAlso "KA 11 §4 (с. 11-7)"@uk .

swe:B_Std a swe:BasicConcept , owl:NamedIndividual ;
    rdfs:label "Стандарт"@uk ;
    rdfs:comment "Нормативний документ, що фіксує узгоджені вимоги до процесів або продуктів"@uk ;
    swe:lpmFormula "(х) I; (о) Rq"@uk ;
    rdfs:seeAlso "KA 18 §8 (с. 18-15); Л2 сл. 37"@uk .

swe:B_OE a swe:BasicConcept , owl:NamedIndividual ;
    rdfs:label "Середовище експлуатації"@uk ;
    rdfs:comment "Інфраструктура (ОС, СКБД, сервери, хмарні платформи), в якій функціонує програмний продукт"@uk ;
    swe:lpmFormula "(х) c; (а) SW"@uk ;
    rdfs:seeAlso "KA 6 §1.1 (с. 6-3), §2.2 (с. 6-7); KA 16 §5–§6"@uk .

swe:B_Sv a swe:BasicConcept , owl:NamedIndividual ;
    rdfs:label "Сервіс (операційна послуга)"@uk ;
    rdfs:comment "Результат операційного процесу, що споживається користувачами за узгодженим рівнем (SLA)"@uk ;
    swe:lpmFormula "(s) SP, OE, Q"@uk ;
    rdfs:seeAlso "KA 6 §2.3 (с. 6-8); ISO/IEC 20000-1:2018"@uk .

swe:B_Ef a swe:BasicConcept , owl:NamedIndividual ;
    rdfs:label "Ефективність процесу"@uk ;
    rdfs:comment "Властивість процесу формувати цільові результати співвіднесено з ресурсами"@uk ;
    swe:lpmFormula "(о) $; —о→ PI"@uk ;
    rdfs:seeAlso "Л3 сл. 9; KA 15 §10.5 (с. 15-17)"@uk .

swe:lpmFormula a owl:AnnotationProperty ; rdfs:label "формула утворення поняття через УЗ"@uk .


